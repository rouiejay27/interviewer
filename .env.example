# Copy this file to .env and fill it in. Never commit .env or paste its values in chat.

# --- Server ---
PORT=3001
# 127.0.0.1 = this computer only (recommended locally). Use 0.0.0.0 on a cloud host.
HOST=127.0.0.1
# Public HTTPS address of this server (your tunnel URL during development, no trailing slash)
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Neon (recommended): pooled string for the app, direct string (no "-pooler" in the host) for migrations.
# Neon Console > Connect. Local Docker alternative: postgres://interviewer:interviewer@localhost:5433/interviewer
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Tavus (https://platform.tavus.io > API keys) ---
TAVUS_API_KEY=
# A stock face ID from your Tavus dashboard (Faces > Stock)
TAVUS_FACE_ID=
# Filled in after you run `npm run create-pal`
TAVUS_PAL_ID=
# true = create conversations without the avatar joining (no minutes used). Use for plumbing tests.
TAVUS_TEST_MODE=false

# --- xAI Grok (https://console.x.ai > API keys) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_LIVE_MODEL=grok-4.20-0309-non-reasoning

# --- Local secrets: generate with `npm run secrets` ---
LLM_PROXY_SECRET=
WEBHOOK_SECRET=
POC_ACCESS_TOKEN=

# Hard call limit in seconds. Tavus Free caps calls at 5 minutes, so keep this under 300.
MAX_CALL_SECONDS=290
