{
  "name": "@interviewer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/server.js",
    "create-pal": "tsx --env-file-if-exists=../../.env src/scripts/create-pal.ts",
    "db:check": "tsx --env-file-if-exists=../../.env src/scripts/db-check.ts",
    "secrets": "tsx src/scripts/gen-secrets.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "create-recruiter": "tsx --env-file-if-exists=../../.env src/scripts/create-recruiter.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
